{
  "name": "sbtc-pool-bond-staker-tests",
  "version": "1.0.0",
  "description": "Pooled sBTC + STX staker for pox-5 Bitcoin Staking Bonds.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"pnpm run test:report\"",
    "fuzz:build": "node scripts/build-rendezvous.mjs",
    "fuzz:invariant": "node scripts/build-rendezvous.mjs && rv . bond-staker invariant",
    "fuzz:test": "node scripts/build-rendezvous.mjs && rv . bond-staker test",
    "build:testnet": "node scripts/build-network.mjs testnet",
    "ui": "python3 -m http.server -d ui 8080",
    "build:mainnet": "node scripts/build-network.mjs mainnet",
    "plan:testnet": "node scripts/make-testnet-plan.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.9.0",
    "@stacks/transactions": "^7.2.0",
    "@types/node": "^24.4.0",
    "chokidar-cli": "^3.0.0",
    "vitest": "^4.1.8",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "@stacks/rendezvous": "^1.0.3"
  }
}
